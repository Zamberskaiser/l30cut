{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AssistantTurn proposto v3",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 3
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "needs_clarification"
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "field": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 350
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "maxItems": 5,
                "uniqueItems": true
              },
              "freeTextAllowed": {
                "const": true
              }
            },
            "required": [
              "field",
              "text",
              "options",
              "freeTextAllowed"
            ]
          }
        }
      },
      "required": [
        "schemaVersion",
        "status",
        "message",
        "questions"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 3
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "ready_for_tools"
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "tool": {
                "enum": [
                  "get_local_context",
                  "inspect_local_capabilities",
                  "search_local_knowledge",
                  "create_script",
                  "transcribe_audio",
                  "create_image",
                  "create_narration",
                  "render_video",
                  "create_text_artifact",
                  "apply_edit_plan"
                ]
              },
              "inputs": {
                "type": "object"
              }
            },
            "required": [
              "tool",
              "inputs"
            ]
          }
        }
      },
      "required": [
        "schemaVersion",
        "status",
        "message",
        "tasks"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 3
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "completed"
        },
        "verifiedArtifactIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "verificationReceiptIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "schemaVersion",
        "status",
        "message",
        "verifiedArtifactIds",
        "verificationReceiptIds"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 3
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "blocked"
        },
        "reason": {
          "enum": [
            "policy_local_only",
            "missing_local_capability",
            "missing_asset",
            "write_failed",
            "read_failed",
            "corrupt_asset",
            "stale_context",
            "cancelled"
          ]
        },
        "localAlternatives": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "schemaVersion",
        "status",
        "message",
        "reason",
        "localAlternatives"
      ]
    }
  ]
}
